#!/bin/sh
"$(dirname "$0")/item-link-guard" index "$1" || exit $?

# 获取包含提交信息的文件路径（由 Git 自动传入）
COMMIT_MSG_FILE=$1

# 读取提交信息内容
# grep -v '^#' 去除以 # 开头的注释行
# tr -d '[:space:]' 删除所有空白字符（空格、换行、制表符）
MSG_CONTENT=$(grep -v '^#' "$COMMIT_MSG_FILE" | tr -d '[:space:]')

# 检查处理后的内容长度是否为 0
if [ -z "$MSG_CONTENT" ]; then
    echo "❌ [ERROR] Commit message cannot be empty!"
    echo "❌ [错误] 提交信息不能为空！请拒绝使用 -m \"\" 这种恶劣行为。"
    echo "👉 Please provide a meaningful commit message."
    # 以非零状态退出，阻止 Git 提交
    exit 1
fi

# 如果检查通过，以 0 状态退出，允许提交
exit 0
